NODE_ENV=development

# Dev-only: lets `POST /api/v1/admissions/:applicationRef/dev-bypass` mark an
# application paid without a real payment, for local testing of the apply ->
# pay -> account flow. Refuses outright when NODE_ENV=production, regardless
# of this flag. Never expose DEV_BYPASS_SECRET or reference this endpoint in
# any client-facing UI.
ENABLE_DEV_PAYMENT_BYPASS=false
DEV_BYPASS_SECRET=
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/masterview

# JWT
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Google Sign In (OAuth 2.0 Client ID -> Google Cloud Console -> APIs & Services -> Credentials)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env exactly (same Client ID, both ends verify against it)
GOOGLE_CLIENT_ID=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLUTTERWAVE_WEBHOOK_SECRET=

# Email (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Masterview Academy <noreply@masterviewacademy.com>

# Frontend
FRONTEND_URL=http://localhost:5173

# Bootstrap super admin (created automatically on first run)
SUPER_ADMIN_EMAIL=superadmin@masterviewacademy.com
SUPER_ADMIN_PASSWORD=ChangeMe@2025!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
